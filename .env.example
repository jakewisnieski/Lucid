# Copy this file to `.env` (gitignored) and fill in real values.
# Never commit real secrets — `.env*` is gitignored except this example.

# Neon Postgres connection string. Read by Prisma (prisma/schema.prisma) and `npm run db:ping`.
DATABASE_URL=

# Anthropic API key for the generator/critic passes — server-side only (used from M3).
ANTHROPIC_API_KEY=
